// Single VALVE3D matching valve3D.mint / valve3D.json.
// FLOW: Port_1 --CHANNEL_1--> Port_2, one VALVE3D on CHANNEL_1.
// CONTROL: Port_3 --> Valve3D_1.
module valve3D(
    finput Port_1,
    foutput Port_2,
    control Port_3
);
    distribute@(Port_3)
    begin
        if (Port_3 == 1)
        begin
            Port_2 <= Port_1;
        end
    end
endmodule
