// Super_MUX_8 — eight flow inlets, one outlet, 3-bit control.
// Matches MINT_TestCases/Base/Super_MUX_8.mint (H MUX 1 to 8, leafSpace=4000, stageSpace=4000).
// CONTROL `c_select` chooses which inlet is connected to `out`.
module mux(
    finput [0:7] inputs,
    foutput out,
    control [0:2] c_select
);
    distribute@(c_select)
    begin
        case(c_select)
            3'b000 : out <= inputs[0];
            3'b001 : out <= inputs[1];
            3'b010 : out <= inputs[2];
            3'b011 : out <= inputs[3];
            3'b100 : out <= inputs[4];
            3'b101 : out <= inputs[5];
            3'b110 : out <= inputs[6];
            3'b111 : out <= inputs[7];
        endcase
    end
endmodule
